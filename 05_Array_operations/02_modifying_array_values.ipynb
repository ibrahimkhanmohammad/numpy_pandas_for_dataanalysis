   "source": [
    "## Modifying array values"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "9acca14c",
   "metadata": {},
   "source": [
    "#### Numpy arrays are mutable so we can update values directly"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 13,
   "id": "97e74ac9",
   "metadata": {},
   "outputs": [],
   "source": [
    "import numpy as np\n",
    "\n",
    "nums = np.array([10, 20, 30, 40, 50])\n",
    "\n",
    "nums[0] = 15\n",
    "nums[-1] = 60\n",
    "nums[1:3] = [10, 10]\n",
    "nums[nums == 40] = 100\n",
    "nums[[3, 4]] = [50, 55]\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 14,
   "id": "d2af7e2e",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "array([15, 10, 10, 50, 55])"
      ]
     },
     "execution_count": 14,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "nums"
   ]
  }
 ],
